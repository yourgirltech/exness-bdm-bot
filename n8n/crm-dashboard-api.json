      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const clients = $input.all().map(i => i.json).filter(r => r && r.chat_id).map(r => ({\n  id: r.id, chat_id: r.chat_id, first_name: r.first_name || 'Unknown',\n  registered: r.registered === true, kyc_verified: r.kyc_verified === true,\n  ftd_amount: Number(r.ftd_amount || 0), balance: Number(r.balance || 0),\n  days_inactive: Number(r.days_inactive || 0), is_ib: r.is_ib === true,\n  ib_referrals: Number(r.ib_referrals || 0), ib_link: r.ib_link || '',\n  one_on_one_booked: r.one_on_one_booked === true, escalated: r.escalated === true, escalation_reason: r.escalation_reason || '',\n  last_track: r.last_track || 'GENERAL',\n  created_at: r.createdAt, updated_at: r.updatedAt\n}));\nreturn [{ json: { ok: true, generated_at: new Date().toISOString(), clients } }];"
      }
    },
