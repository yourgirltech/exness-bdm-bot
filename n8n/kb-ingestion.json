      ],
      "parameters": {}
    },
    {
      "id": "37276a62-ebbe-4082-8f2d-8ddad865c31e",
      "name": "Load KB Sections",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const kb = String($input.first().json.data || '');\nif (kb.length < 1000) throw new Error('Knowledge base download looks empty or truncated');\nconst parts = kb.split('\\n## ');\nconst out = [];\nfor (let i = 1; i < parts.length; i++) {\n  const p = parts[i];\n  const nl = p.indexOf('\\n');\n  const section = p.slice(0, nl).trim();\n  out.push({ json: { section, text: '## ' + p.trim() } });\n}\nreturn out;"
      }
    },
    {
      "id": "61f62313-66c6-4ce8-93cb-e222fc0e9caa",
      "name": "Exness KB Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "id",
          "value": "exness_kb"
        },
        "clearStore": true
      }
    },
